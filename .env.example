# ---------------------------------------------------------------------------
# Bella Cucina — environment variables
# Copy to .env.local for local development. Everything here is OPTIONAL:
# with an empty file the demo runs fully on a local SQLite file, simulated
# payments and on-screen login codes.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Local dev leaves these unset and uses file:./.data/db.sqlite
# Production (Vercel) MUST set these — see docs/DEMO.md §Deploy.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Legacy alias accepted for TURSO_DATABASE_URL
DB_STORAGE_URL=

# --- Sessions --------------------------------------------------------------
# Signing key for staff + customer session cookies.
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Accepted alias if you already have one from a next-auth project
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Payments (optional) ---------------------------------------------------
# Without these the checkout uses the built-in Simulated payment flow, which
# drives the exact same order/payment state machine.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_BASE_URL=

# --- Email (optional) ------------------------------------------------------
# Without this, 6-digit login codes appear on screen and in the in-app Inbox.
# With it, the same code is also emailed via Resend.
RESEND_API_KEY=
RESEND_FROM="Bella Cucina <onboarding@resend.dev>"

# --- Seeding a deployed instance -------------------------------------------
# curl -X POST https://<your-app>.vercel.app/api/seed-protected \
#   -H "Authorization: Bearer $ADMIN_SEED_TOKEN"
ADMIN_SEED_TOKEN=
